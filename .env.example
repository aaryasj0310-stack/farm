# Application Environment
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Hardware & Model Device (auto, cpu, cuda)
MODEL_DEVICE=auto
COMPUTE_TYPE=int8
CPU_THREADS=4

# ASR (Speech-to-Text) Model (tiny, base, small, medium, large-v3)
ASR_MODEL_SIZE=small
ASR_LANGUAGE=hi

# VAD Settings
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_DURATION_MS=250
VAD_MIN_SILENCE_DURATION_MS=200

# Speaker Diarization Settings
DIARIZATION_ENGINE=auto
HF_TOKEN=

# LLM Reasoning Settings (none, openrouter, openai, ollama)
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

# Storage & Cache Paths
STORAGE_DIR=data/jobs
CACHE_DIR=data/cache
MAX_AUDIO_FILE_SIZE_MB=100
MAX_AUDIO_DURATION_SEC=3600
