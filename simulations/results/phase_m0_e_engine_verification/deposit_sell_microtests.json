{
  "test_1_drop_then_sell_same_turn": {
    "description": "Worker drops 10 STRAWBERRY to shed; same action packet sells 10 STRAWBERRY.",
    "pre": {
      "farmer_inventory": 10,
      "shed_strawberry": 0,
      "money": 1000.0,
      "market_inventory": 10000,
      "market_price": 120
    },
    "action": {
      "farmer": [
        "DROP"
      ],
      "hands": [],
      "market": [
        [
          "SELL",
          "STRAWBERRY",
          10
        ]
      ]
    },
    "post": {
      "farmer_inventory": 0,
      "shed_strawberry": 0,
      "money": 2113.0,
      "revenue": 1113.0,
      "market_inventory": 10009,
      "market_price": 103
    },
    "success": true
  },
